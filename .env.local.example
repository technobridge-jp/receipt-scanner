# Gemini API (AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
# デフォルト: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Vertex AI への切り替え（env を変えるだけで切替可能）
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# 本番(Vercel)用。ローカルは ADC (gcloud auth application-default login) を使うため未設定でよい
# GCP_SERVICE_ACCOUNT_KEY=

# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Usage logging (optional)
USAGE_DASHBOARD_URL=

# Database (Supabase, 東京 ap-northeast-1) — マルチテナント化フェーズ0で追加
# DATABASE_URL : 実行時(Prisma Client)。Supabase のトランザクション・プーラー(Supavisor, port 6543)経由。
#                アプリ専用ロール(receipt_scanner_app / 非superuser・非BYPASSRLS)を使う。
#                例) postgresql://receipt_scanner_app.<project-ref>:<pw>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL   : マイグレーション用。直結(port 5432)・所有者(postgres)ロール。
#                例) postgresql://postgres:<pw>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=

# テストログイン（ローカル開発専用。本番ビルドでは NODE_ENV=production になるため
# ここを true にしても next-auth の設定側で無効化される。prisma/seed.ts が
# test-admin@example.com をADMIN権限で作成している前提）
# ENABLE_TEST_LOGIN=true
